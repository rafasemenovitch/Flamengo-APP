{
  "//": "Só para checar tipos no npm run check; quem executa é o Deno da Edge Function.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "npm:@supabase/supabase-js@2": ["../../node_modules/@supabase/supabase-js"],
      "npm:fast-png@6": ["../../node_modules/fast-png"],
      "npm:jpeg-js@0.4": ["../../node_modules/jpeg-js"]
    }
  },
  "include": ["deno-shim.d.ts", "*/**/*.ts"]
}
