{
  "expo": {
    "name": "Flamengo App",
    "slug": "flamengo-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "flamengoapp",
    "backgroundColor": "#0A0A0C",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.flamengoapp"
    },
    "android": {
      "package": "com.example.flamengoapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#0A0A0C"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0C"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Flamengo App usa a câmera para cadastrar seu rosto no acesso por reconhecimento facial ao estádio.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Flamengo App usa sua localização para mostrar o melhor caminho até o Maracanã."
        }
      ]
    ],
    "icon": "./assets/brand/icon.png",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "eas": {
        "projectId": "fc684d85-dbe4-483e-8330-44e088324fd7"
      }
    },
    "owner": "flamengo-app",
    "updates": {
      "url": "https://u.expo.dev/fc684d85-dbe4-483e-8330-44e088324fd7"
    }
  }
}
